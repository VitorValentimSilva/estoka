<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Identity e segurança">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Aplicação">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Observabilidade">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
</Project>
