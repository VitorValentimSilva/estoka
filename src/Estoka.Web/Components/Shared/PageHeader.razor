<PageTitle>@Title · Estoka</PageTitle>

<div class="page-header">
    @if (Breadcrumbs is { Count: > 0 })
    {
        <MudBreadcrumbs Items="AllBreadcrumbs" Class="pa-0 mb-1 page-header__crumbs" />
    }
    <div class="page-header__row">
        <div class="page-header__titles">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="page-header__title">@Title</MudText>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="page-header__actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private List<BreadcrumbItem> AllBreadcrumbs =>
        [new("Início", "/", icon: Icons.Material.Filled.Home), .. Breadcrumbs ?? []];
}
